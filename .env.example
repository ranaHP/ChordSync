# App
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-openssl-rand-base64-32

# Google OAuth
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# MongoDB
DATABASE_URL=mysql://root:password@127.0.0.1:3306/chordsync

# Pusher realtime (no separate backend server required)
PUSHER_APP_ID=your-pusher-app-id
PUSHER_SECRET=your-pusher-secret
NEXT_PUBLIC_PUSHER_KEY=your-pusher-key
NEXT_PUBLIC_PUSHER_CLUSTER=your-pusher-cluster

# Demo credentials (use when Google OAuth is not configured)
DEMO_USER_EMAIL=demo@chordsync.local
DEMO_USER_PASSWORD=demo12345
